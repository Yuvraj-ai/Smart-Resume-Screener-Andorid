<?xml version="1.0" encoding="utf-8"?>
<!-- Credentials live in EncryptedSharedPreferences. Exclude everything from
     both cloud backup and device-to-device transfer so the API key never
     leaves the device it was entered on. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
